# SwasthyaSetu - Environment Configuration
# Copy this file to .env or .env.local to customize your configuration

# Application Settings
VITE_APP_NAME="SwasthyaSetu"
VITE_APP_VERSION="1.0.0"
VITE_PORT=7000

# Backend API Configuration
# During hackathon/demo mode, the application uses integrated mock data & local state.
# Set VITE_ENABLE_MOCK_DATA to false when connecting to a live backend.
VITE_ENABLE_MOCK_DATA=true
VITE_API_BASE_URL=http://localhost:7000/api
VITE_API_TIMEOUT_MS=10000

# Emergency & Referral Gateway
VITE_EMERGENCY_HOTLINE="108"
VITE_MATERNAL_HOTLINE="102"
VITE_SMS_GATEWAY_URL="http://localhost:7000/api/sms"

# Maps & Geolocation
# Optional: Set your Mapbox or Google Maps key for live routing; mock radar coordinates are used by default
VITE_MAP_PROVIDER="mock"
VITE_MAPS_API_KEY=""

# ABHA / Ayushman Bharat Digital Mission (ABDM) Integration
VITE_ABHA_CLIENT_ID="demo-abha-client"
VITE_ABHA_SANDBOX_URL="https://healthidsbx.abdm.gov.in"

# Teleconsultation / WebRTC Configuration
VITE_WEBRTC_SIGNALING_URL="wss://localhost:7000/ws"
